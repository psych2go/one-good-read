{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "./worker-configuration.d.ts"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
