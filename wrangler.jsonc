{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "one-good-read",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/archive*", "/read/*", "/about", "/admin/*", "/api/*", "/health"]
  },
  "vars": {
    "APP_NAME": "One Good Read",
    "APP_ORIGIN": "https://read.zhuying.fun",
    "AI_PROVIDER": "heuristic",
    "AI_MODEL": "gpt-5.4",
    "AI_BASE_URL": "https://api.openai.com/v1",
    "ANALYSIS_VERSION": "blind-v1-context-v1",
    "EMBEDDING_PROVIDER": "heuristic",
    "EMBEDDING_MODEL": "text-embedding-3-small",
    "EMBEDDING_BASE_URL": "",
    "EMBEDDING_DIMENSIONS": "384",
    "EMBEDDING_VERSION": "embedding-v1",
    "PREFERENCE_MODEL_VERSION": "ridge-v1",
    "SELECTION_VERSION": "selection-v2-semantic",
    "ADMIN_EMAIL": "zhuyingqiuhua@gmail.com",
    "ACCESS_TEAM_DOMAIN": "https://aaron-bjtu.cloudflareaccess.com",
    "ACCESS_AUD": "5f52c1d816a02ab2a34e3fc39925169d6b60c8aea40b1b4477aa2ce85d5cefad",
    "ALERTS_ENABLED": "false",
    "ALERT_TO_EMAIL": "",
    "ALERT_FROM_EMAIL": "",
    "R2_STORAGE_LIMIT_BYTES": "10000000000",
    "AUTOMATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "one-good-read",
      "database_id": "4ea72c4b-ded9-4c87-86ac-8bb849546acd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "one-good-read-content"
    }
  ],
  "vectorize": [
    {
      "binding": "ARTICLE_VECTORS",
      "index_name": "one-good-read-articles"
    }
  ],
  "workflows": [
    {
      "binding": "DAILY_WORKFLOW",
      "name": "one-good-read-daily",
      "class_name": "DailyReadingWorkflow"
    },
    {
      "binding": "BACKFILL_WORKFLOW",
      "name": "one-good-read-backfill",
      "class_name": "BackfillWorkflow"
    }
  ],
  "triggers": {
    "crons": ["30 16 * * *", "30 22 * * *"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "read.zhuying.fun", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
